index 00000000..4ceb717e
--- /dev/null
+++ b/method_comparison/MetaMathQA/modal_run.py
@@ -0,0 +1,107 @@
+"""Run MetaMathQA experiments on Modal, one NVIDIA L40S each (the GPU of PEFT's official results).
+
+  modal run modal_run.py::check                       # environment check on an L40S, about 2 min
+  modal run --detach modal_run.py::main               # the three experiments, in parallel
+  modal volume get peft-bench-results / ./modal_results
+
+Every experiment runs with the default training parameters of the benchmark, as the official results did.
+The model comes from the volume peft-bench-hf (uploaded from a local cache, revision 13afe51), so no Hugging Face
+token is needed. Each experiment writes its result JSON, log, code record and adapter to peft-bench-results.
+"""
+
+import os
+import subprocess
+import time
+from pathlib import Path
+
+import modal
+
+REPO = "/root/peft-bench"
+BENCH = f"{REPO}/method_comparison/MetaMathQA"
+EXPERIMENTS = ["lora/llama-3.2-3B-rank32", "phase_lora/llama-3.2-3B-rank32", "polar/llama-3.2-3B-rank32"]
+# the image is defined on the local machine; inside the container this file sits at /root, with no repo above it
+LOCAL_REPO = Path(__file__).resolve().parents[2] if modal.is_local() else Path(REPO)
+
+# The library versions of the official result files (torch 2.13.0+cu130, transformers 5.13.1, datasets 4.2.0)
+image = (
+    modal.Image.debian_slim(python_version="3.12")
+    .apt_install("git", "util-linux")
+    .pip_install("torch==2.13.0", index_url="https://download.pytorch.org/whl/cu130")
+    .pip_install("transformers==5.13.1", "datasets==4.2.0", "bitsandbytes", "numpy", "tqdm", "accelerate", "safetensors")
+    .env({"HF_HOME": "/hf", "HF_DATASETS_CACHE": "/root/hf_datasets", "PYTHONUNBUFFERED": "1"})
+    .add_local_dir(
+        LOCAL_REPO, REPO, copy=True,
+        ignore=[".venv", "**/__pycache__", "method_comparison/MetaMathQA/checkpoints",
+                "method_comparison/MetaMathQA/logs", "method_comparison/MetaMathQA/temporary_results",
+                "method_comparison/MetaMathQA/cancelled_results", "**/smoke-20steps"],
+    )
+    .run_commands(f"pip install -e {REPO}")
+)
+app = modal.App("peft-bench-phase-methods", image=image)
+hf_volume = modal.Volume.from_name("peft-bench-hf")
+results_volume = modal.Volume.from_name("peft-bench-results")
+
+
+@app.function(gpu="L40S", timeout=600, volumes={"/hf": hf_volume})
+def check():
+    """GPU, library versions, git branch, model files and the two new methods, before any paid run."""
+    import torch
+    import transformers
+    import datasets
+    import peft
+    from transformers import AutoConfig
+
+    print(subprocess.run(["nvidia-smi", "--query-gpu=name,memory.total,driver_version", "--format=csv"],
+                         capture_output=True, text=True).stdout)
+    print("torch", torch.__version__, "cuda", torch.cuda.is_available(), torch.cuda.get_device_name(0))
+    print("transformers", transformers.__version__, "datasets", datasets.__version__, "peft", peft.__version__)
+    print("branch", subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=REPO, capture_output=True,
+                                    text=True).stdout.strip())
+    print("model", AutoConfig.from_pretrained("meta-llama/Llama-3.2-3B").model_type,
+          sorted(p.name for p in Path("/hf/hub/models--meta-llama--Llama-3.2-3B/snapshots").glob("*/*")))
+    print("methods", peft.PhaseLoraConfig.__name__, peft.PolarConfig.__name__)
+    # sha256 of the weights must equal the Hub's blob names of revision 13afe51
+    expected = {"model-00001-of-00002.safetensors": "584d8d3e3f82f7964955174dfe5e3b1cf117a9d859f022cfdf7fcb884856e002",
+                "model-00002-of-00002.safetensors": "4719a04514ec2f060240711b7c33ab21187cac730ecaba3040b7a0fd95a9cefb"}
+    snapshot = Path("/hf/hub/models--meta-llama--Llama-3.2-3B/snapshots/13afe5124825b4f3751f836b40dafda64c1ed062")
+    for filename, digest in expected.items():
+        found = subprocess.run(["sha256sum", str(snapshot / filename)], capture_output=True, text=True).stdout.split()[0]
+        print(filename, "sha256 ok" if found == digest else f"SHA256 MISMATCH {found}")
+    x = torch.randn(1024, 1024, device="cuda", dtype=torch.bfloat16)
+    print("matmul ok", float((x @ x).float().abs().mean()))
+
+
+# max_inputs=1: a fresh container per experiment, so no files of one run reach the output folder of another
+@app.function(gpu="L40S", timeout=3 * 3600, cpu=8.0, memory=32768, max_inputs=1,
+              volumes={"/hf": hf_volume, "/results": results_volume})
+def run_experiment(experiment: str) -> str:
+    name = experiment.replace("/", "--")
+    # A private copy of the model cache: the run downloads the datasets into HF_HOME, and three containers writing
+    # to one shared volume at the same time could corrupt it (Modal volumes have no cross-container file locks)
+    Path("/root/hf").mkdir(exist_ok=True)
+    subprocess.run(["cp", "-r", "/hf/hub", "/root/hf/"], check=True)
+    process = subprocess.run(["bash", "run_phase_methods.sh", experiment], cwd=BENCH,
+                             env={**os.environ, "PYTHON": "python", "HF_HOME": "/root/hf"},
+                             capture_output=True, text=True)
+    # a new folder per attempt, so a rerun never mixes with or overwrites an earlier one
+    out = Path("/results") / f"{name}_{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}"
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "runner_output.txt").write_text(process.stdout + process.stderr)
+    for folder in ("logs", "temporary_results", "cancelled_results", "checkpoints"):
+        source = Path(BENCH) / folder
+        if source.exists():
+            subprocess.run(["cp", "-r", str(source), str(out / folder)], check=True)
+    results_volume.commit()
+    return f"{experiment}: exit {process.returncode}\n{process.stdout[-2000:]}"
+
+
+@app.local_entrypoint()
+def main(experiments: str = ""):
+    """--experiments takes a comma-separated list of experiment folders; empty runs EXPERIMENTS."""
+    chosen = [name for name in experiments.split(",") if name] or EXPERIMENTS
+    here = Path(__file__).resolve().parent
+    missing = [name for name in chosen if not (here / "experiments" / name / "adapter_config.json").exists()]
+    if missing:
+        raise SystemExit(f"no experiment folder with adapter_config.json: {missing}")
+    for summary in run_experiment.map(chosen, return_exceptions=True):
+        print(summary)
