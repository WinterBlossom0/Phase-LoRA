index 00000000..1b87a84a
--- /dev/null
+++ b/src/peft/tuners/phase_lora/layer.py
@@ -0,0 +1,117 @@
+from __future__ import annotations
+
+import math
+import warnings
+from typing import Any, Optional
+
+import torch
+from torch import nn
+
+from peft.tuners.tuners_utils import BaseTunerLayer, check_adapters_to_merge
+
+
+class PhaseLoraLayer(BaseTunerLayer):
+    adapter_layer_names = ("phase_lora_rho_a", "phase_lora_phi_a", "phase_lora_rho_b", "phase_lora_phi_b")
+    other_param_names = ("r", "scaling")
+
+    def __init__(self, base_layer: nn.Module, **kwargs) -> None:
+        self.base_layer = base_layer
+        self.r = {}
+        self.scaling = {}
+        self.phase_lora_rho_a = nn.ParameterDict({})
+        self.phase_lora_phi_a = nn.ParameterDict({})
+        self.phase_lora_rho_b = nn.ParameterDict({})
+        self.phase_lora_phi_b = nn.ParameterDict({})
+        self._disable_adapters = False
+        self.merged_adapters = []
+        self.kwargs = kwargs
+        base = self.get_base_layer()
+        if not isinstance(base, nn.Linear):
+            raise TypeError(f"Unsupported layer type {type(base)}")
+        self.in_features, self.out_features = base.in_features, base.out_features
+
+    def update_layer(
+        self, adapter_name: str, r: int, lora_alpha: float, init_weights: bool = True, inference_mode: bool = False
+    ) -> None:
+        complex_rank = r // 2
+        self.r[adapter_name] = r
+        self.scaling[adapter_name] = lora_alpha / r
+        # The input side takes LoRA's lora_A init: per-entry variance 1 / (3 in) in each real component, as
+        # kaiming_uniform(a = sqrt(5)) gives lora_A. The output side starts at modulus 0, so dW = 0 at init.
+        input_side = torch.randn(self.in_features, complex_rank, 2) / math.sqrt(3 * self.in_features)
+        self.phase_lora_rho_b[adapter_name] = nn.Parameter(input_side.norm(dim=-1))
+        self.phase_lora_phi_b[adapter_name] = nn.Parameter(torch.atan2(input_side[..., 1], input_side[..., 0]))
+        output_modulus = torch.zeros(self.out_features, complex_rank)
+        if not init_weights:
+            output_modulus = torch.randn(self.out_features, complex_rank, 2).norm(dim=-1) / math.sqrt(3 * self.out_features)
+        self.phase_lora_rho_a[adapter_name] = nn.Parameter(output_modulus)
+        self.phase_lora_phi_a[adapter_name] = nn.Parameter(torch.rand(self.out_features, complex_rank) * 2 * math.pi)
+        self._move_adapter_to_device_of_base_layer(adapter_name)
+        self.set_adapter(self.active_adapters, inference_mode=inference_mode)
+
+    def factors(self, adapter: str):
+        """The equivalent real factors (Ar, Ai, Br, Bi); Re(A B^H) = Ar Br^T + Ai Bi^T."""
+        rho_a, phi_a = self.phase_lora_rho_a[adapter], self.phase_lora_phi_a[adapter]
+        rho_b, phi_b = self.phase_lora_rho_b[adapter], self.phase_lora_phi_b[adapter]
+        return rho_a * phi_a.cos(), rho_a * phi_a.sin(), rho_b * phi_b.cos(), rho_b * phi_b.sin()
+
+    def get_delta_weight(self, adapter: str) -> torch.Tensor:
+        a_real, a_imag, b_real, b_imag = self.factors(adapter)
+        return self.scaling[adapter] * (a_real @ b_real.T + a_imag @ b_imag.T)
+
+
+class PhaseLoraLinear(nn.Module, PhaseLoraLayer):
+    def __init__(
+        self, base_layer, adapter_name: str, r: int, lora_alpha: float, init_weights: bool = True,
+        inference_mode: bool = False, **kwargs,
+    ):
+        super().__init__()
+        PhaseLoraLayer.__init__(self, base_layer, **kwargs)
+        self._active_adapter = adapter_name
+        self.update_layer(adapter_name, r, lora_alpha, init_weights=init_weights, inference_mode=inference_mode)
+
+    def merge(self, safe_merge: bool = False, adapter_names: Optional[list[str]] = None) -> None:
+        adapter_names = check_adapters_to_merge(self, adapter_names)
+        base = self.get_base_layer()
+        for adapter in adapter_names:
+            if adapter not in self.phase_lora_rho_a:
+                continue
+            delta = self.get_delta_weight(adapter).detach().to(base.weight.dtype)
+            merged = base.weight.data + delta
+            if safe_merge and not torch.isfinite(merged).all():
+                raise ValueError(f"NaNs detected in the merged weights of adapter {adapter}")
+            base.weight.data = merged
+            self.merged_adapters.append(adapter)
+
+    def unmerge(self) -> None:
+        if not self.merged:
+            warnings.warn("Already unmerged. Nothing to do.")
+            return
+        base = self.get_base_layer()
+        while self.merged_adapters:
+            adapter = self.merged_adapters.pop()
+            if adapter in self.phase_lora_rho_a:
+                base.weight.data -= self.get_delta_weight(adapter).detach().to(base.weight.dtype)
+
+    def forward(self, x: torch.Tensor, *args: Any, **kwargs: Any) -> torch.Tensor:
+        if self.disable_adapters:
+            if self.merged:
+                self.unmerge()
+            return self.base_layer(x, *args, **kwargs)
+        if self.merged:
+            return self.base_layer(x, *args, **kwargs)
+        result = self.base_layer(x, *args, **kwargs)
+        result_dtype = result.dtype
+        for adapter in self.active_adapters:
+            if adapter not in self.phase_lora_rho_a:
+                continue
+            a_real, a_imag, b_real, b_imag = self.factors(adapter)
+            # The adapter branch runs in the adapter dtype (fp32 under autocast_adapter_dtype), as LoRA's does.
+            # dW is never built: two low-rank products.
+            x_adapter = self._cast_input_dtype(x, a_real.dtype)
+            update = (x_adapter @ b_real) @ a_real.T + (x_adapter @ b_imag) @ a_imag.T
+            result = result + update * self.scaling[adapter]
+        return result.to(result_dtype)
+
+    def __repr__(self) -> str:
+        return "phase_lora." + super().__repr__()
