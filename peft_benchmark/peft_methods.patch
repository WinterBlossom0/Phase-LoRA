+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Optional, Union
+
+from peft.config import PeftConfig
+from peft.utils import PeftType
+
+
+@dataclass
+class PolarConfig(PeftConfig):
+    """PoLAR (Lion et al., NeurIPS 2025): dW = (alpha / r) X Theta Y^T with X, Y near the Stiefel manifold.
+
+    Before each optimizer step, the gradients of X and Y are replaced with the landing field of the official
+    code: (G X^T - X G^T) X + landing_lambda X (X^T X - I).
+    """
+
+    r: int = field(default=8, metadata={"help": "Rank of X, Y and Theta."})
+    lora_alpha: int = field(default=8, metadata={"help": "Scale numerator: dW is multiplied by lora_alpha / r."})
+    landing_lambda: float = field(default=5e-3, metadata={"help": "Weight of the term X (X^T X - I) in the landing field."})
+    init_weights: bool = field(
+        default=True,
+        metadata={"help": "True: dW = 0 at init (the method's init). False: a random nonzero dW, used only by tests."},
+    )
+    target_modules: Optional[Union[list[str], str]] = field(
+        default=None, metadata={"help": "Module names or a regex of the modules to adapt."}
+    )
+    exclude_modules: Optional[Union[list[str], str]] = field(
+        default=None, metadata={"help": "Module names or a regex of the modules not to adapt."}
+    )
+    layers_to_transform: Optional[Union[list[int], int]] = field(default=None, metadata={"help": "Layer indices to adapt."})
+    layers_pattern: Optional[Union[list[str], str]] = field(default=None, metadata={"help": "Name of the layer list."})
+    modules_to_save: Optional[list[str]] = field(default=None, metadata={"help": "Extra modules to train and save."})
+
+    def __post_init__(self):
+        super().__post_init__()
+        self.peft_type = PeftType.POLAR
+        self.target_modules = set(self.target_modules) if isinstance(self.target_modules, list) else self.target_modules
+        self.exclude_modules = (
+            set(self.exclude_modules) if isinstance(self.exclude_modules, list) else self.exclude_modules
+        )
+        if self.layers_pattern and self.layers_to_transform is None:
+            raise ValueError("When `layers_pattern` is specified, `layers_to_transform` must also be specified.")
+        if self.r <= 0:
+            raise ValueError(f"`r` must be a positive integer; got {self.r}.")
+        if self.landing_lambda < 0:
+            raise ValueError(f"`landing_lambda` must be non-negative; got {self.landing_lambda}.")
diff --git a/src/peft/tuners/polar/layer.py b/src/peft/tuners/polar/layer.py
new file mode 100644
index 00000000..1e4d22e2
--- /dev/null
+++ b/src/peft/tuners/polar/layer.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+import warnings
+from typing import Any, Optional
+
+import torch
+from torch import nn
+
+from peft.tuners.tuners_utils import BaseTunerLayer, check_adapters_to_merge
+
+
+def landing_field(factor: torch.Tensor, grad: torch.Tensor, landing_lambda: float) -> torch.Tensor:
+    """PoLAR's landing field for a tall factor (rows > rank), as the official code computes it:
+    (G X^T - X G^T) X + lambda X (X^T X - I). Source: github.com/kcc-lion/polar, callbacks/landing_callback.py."""
+    product = grad @ factor.transpose(-1, -2)
+    skew = product - product.transpose(-1, -2)
+    distance = factor.transpose(-1, -2) @ factor
+    distance.diagonal().add_(-1.0)
+    return skew @ factor + landing_lambda * (factor @ distance)
+
+
+def stiefel_init(rows: int, rank: int) -> torch.Tensor:
+    """Uniform on St(rows, rank): QR of a Gaussian, with signs fixed so that R has a positive diagonal."""
+    q, upper = torch.linalg.qr(torch.randn(rows, rank))
+    # QR returns a column-major Q; a contiguous copy, since FSDP and flat views need contiguous parameters
+    return (q * torch.sign(torch.diagonal(upper)).unsqueeze(0)).contiguous()
+
+
+class PolarLayer(BaseTunerLayer):
+    adapter_layer_names = ("polar_X", "polar_Y", "polar_theta")
+    other_param_names = ("r", "scaling", "landing_lambda")
+
+    def __init__(self, base_layer: nn.Module, **kwargs) -> None:
+        self.base_layer = base_layer
+        self.r = {}
+        self.scaling = {}
+        self.landing_lambda = {}
+        self.polar_X = nn.ParameterDict({})
+        self.polar_Y = nn.ParameterDict({})
+        self.polar_theta = nn.ParameterDict({})
+        self._disable_adapters = False
+        self.merged_adapters = []
+        self.kwargs = kwargs
+        base = self.get_base_layer()
+        if not isinstance(base, nn.Linear):
+            raise TypeError(f"Unsupported layer type {type(base)}")
+        self.in_features, self.out_features = base.in_features, base.out_features
+
+    def update_layer(
+        self, adapter_name: str, r: int, lora_alpha: float, landing_lambda: float, init_weights: bool = True,
+        inference_mode: bool = False,
+    ) -> None:
+        if r > min(self.in_features, self.out_features):
+            # X and Y start on the Stiefel manifold, which needs rank <= rows
+            raise ValueError(f"`r` = {r} exceeds min(in_features, out_features) = {min(self.in_features, self.out_features)}")
+        self.r[adapter_name] = r
+        self.scaling[adapter_name] = lora_alpha / r
+        self.landing_lambda[adapter_name] = landing_lambda
+        self.polar_X[adapter_name] = nn.Parameter(stiefel_init(self.out_features, r))
+        self.polar_Y[adapter_name] = nn.Parameter(stiefel_init(self.in_features, r))
+        # Theta_0 = 0, so dW = 0 at init (PoLAR's init)
+        theta = torch.zeros(r, r) if init_weights else torch.randn(r, r) / r
+        self.polar_theta[adapter_name] = nn.Parameter(theta)
+        self._move_adapter_to_device_of_base_layer(adapter_name)
+        self.set_adapter(self.active_adapters, inference_mode=inference_mode)
+
+    def get_delta_weight(self, adapter: str) -> torch.Tensor:
+        return self.scaling[adapter] * (self.polar_X[adapter] @ self.polar_theta[adapter] @ self.polar_Y[adapter].T)
+
+    @torch.no_grad()
+    def apply_landing(self, trained: set) -> None:
+        """Replace the gradients of X and Y with the landing field. Runs after gradient clipping, before the
+        optimizer step, as the official code's on_pre_optimizer_step callback does."""
+        for adapter, landing_lambda in self.landing_lambda.items():
+            for factor in (self.polar_X[adapter], self.polar_Y[adapter]):
+                if factor.grad is not None and id(factor) in trained:
+                    factor.grad.copy_(landing_field(factor, factor.grad, landing_lambda))
+
+
+class PolarLinear(nn.Module, PolarLayer):
+    def __init__(
+        self, base_layer, adapter_name: str, r: int, lora_alpha: float, landing_lambda: float,
+        init_weights: bool = True, inference_mode: bool = False, **kwargs,
+    ):
+        super().__init__()
+        PolarLayer.__init__(self, base_layer, **kwargs)
+        self._active_adapter = adapter_name
+        self.update_layer(
+            adapter_name, r, lora_alpha, landing_lambda, init_weights=init_weights, inference_mode=inference_mode
+        )
+
+    def merge(self, safe_merge: bool = False, adapter_names: Optional[list[str]] = None) -> None:
+        adapter_names = check_adapters_to_merge(self, adapter_names)
+        base = self.get_base_layer()
+        for adapter in adapter_names:
+            if adapter not in self.polar_X:
+                continue
+            delta = self.get_delta_weight(adapter).detach().to(base.weight.dtype)
+            merged = base.weight.data + delta
+            if safe_merge and not torch.isfinite(merged).all():
+                raise ValueError(f"NaNs detected in the merged weights of adapter {adapter}")
+            base.weight.data = merged
+            self.merged_adapters.append(adapter)
+
+    def unmerge(self) -> None:
+        if not self.merged:
+            warnings.warn("Already unmerged. Nothing to do.")
+            return
+        base = self.get_base_layer()
+        while self.merged_adapters:
+            adapter = self.merged_adapters.pop()
+            if adapter in self.polar_X:
+                base.weight.data -= self.get_delta_weight(adapter).detach().to(base.weight.dtype)
+
+    def forward(self, x: torch.Tensor, *args: Any, **kwargs: Any) -> torch.Tensor:
+        if self.disable_adapters:
+            if self.merged:
+                self.unmerge()
+            return self.base_layer(x, *args, **kwargs)
+        if self.merged:
+            return self.base_layer(x, *args, **kwargs)
+        result = self.base_layer(x, *args, **kwargs)
+        result_dtype = result.dtype
+        for adapter in self.active_adapters:
+            if adapter not in self.polar_X:
+                continue
+            x_factor, y_factor = self.polar_X[adapter], self.polar_Y[adapter]
+            # The adapter branch runs in the adapter dtype (fp32 under autocast_adapter_dtype), as LoRA's does.
+            x_adapter = self._cast_input_dtype(x, x_factor.dtype)
+            update = ((x_adapter @ y_factor) @ self.polar_theta[adapter].T) @ x_factor.T
+            result = result + update * self.scaling[adapter]
+        return result.to(result_dtype)
+
+    def __repr__(self) -> str:
+        return "polar." + super().__repr__()
