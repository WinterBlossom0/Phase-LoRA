@@ -0,0 +1,52 @@
+from __future__ import annotations
+
+import weakref
+
+import torch
+from torch.optim.optimizer import register_optimizer_step_pre_hook
+
+from peft.tuners.tuners_utils import BaseTuner, BaseTunerLayer
+from peft.utils import TRANSFORMERS_MODELS_TO_POLAR_TARGET_MODULES_MAPPING
+
+from .layer import PolarLayer, PolarLinear
+
+
+class PolarModel(BaseTuner):
+    prefix: str = "polar_"
+    tuner_layer_cls = PolarLayer
+    target_module_mapping = TRANSFORMERS_MODELS_TO_POLAR_TARGET_MODULES_MAPPING
+
+    def __init__(self, model, config, adapter_name, **kwargs) -> None:
+        super().__init__(model, config, adapter_name, **kwargs)
+        # A global optimizer pre-step hook: the training loop clips the Euclidean gradient first, then the hook
+        # swaps in the landing field, the order of the official code. A weak reference keeps the model collectable.
+        model_reference = weakref.ref(self)
+
+        def landing_hook(optimizer, args, kwargs):
+            polar_model = model_reference()
+            if polar_model is None:
+                return
+            trained = {id(param) for group in optimizer.param_groups for param in group["params"]}
+            for module in polar_model.model.modules():
+                if isinstance(module, PolarLayer):
+                    module.apply_landing(trained)
+
+        self.landing_hook_handle = register_optimizer_step_pre_hook(landing_hook)
+
+    def _create_and_replace(self, config, adapter_name, target, target_name, parent, current_key, **optional_kwargs):
+        if isinstance(target, PolarLinear):
+            target.update_layer(
+                adapter_name, config.r, config.lora_alpha, config.landing_lambda, init_weights=config.init_weights,
+                inference_mode=config.inference_mode,
+            )
+            return
+        base = target.get_base_layer() if isinstance(target, BaseTunerLayer) else target
+        if not isinstance(base, torch.nn.Linear):
+            raise TypeError(f"Target module {target} is not supported; only torch.nn.Linear is.")
+        new_module = PolarLinear(
+            target, adapter_name, config.r, config.lora_alpha, config.landing_lambda,
+            init_weights=config.init_weights, inference_mode=config.inference_mode,
+        )
+        if adapter_name not in self.active_adapters:
+            new_module.requires_grad_(False)
+        self._replace_module(parent, target_name, new_module, target)
