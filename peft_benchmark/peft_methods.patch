     return model
 
 
+PLATEAU_FACTOR = 0.5  # the learning rate is halved at each plateau
+# PyTorch cuts when the evaluations without improvement exceed patience: patience 1 cuts at the 2nd such
+# evaluation, that is after 2 * eval_steps steps without improvement
+PLATEAU_PATIENCE = 1
+
+
+class WarmupPlateauScheduler:
+    """Linear warmup to the base learning rate, as in the cosine schedule, then ReduceLROnPlateau on the training
+    loss averaged over each eval_steps window. run.py calls step() every training step and plateau_step(loss) at
+    every evaluation; plateau_step does nothing during the warmup."""
+
+    def __init__(self, optimizer, *, warmup_steps: int):
+        self.optimizer = optimizer
+        self.warmup_steps = warmup_steps
+        self.base_lrs = [group["lr"] for group in optimizer.param_groups]
+        self.steps_done = 0
+        self.plateau = torch.optim.lr_scheduler.ReduceLROnPlateau(
+            optimizer, mode="min", factor=PLATEAU_FACTOR, patience=PLATEAU_PATIENCE
+        )
+        self._set_warmup_lr()
+
+    def _set_warmup_lr(self):
+        # the cosine schedule's warmup factor: step / warmup_steps, 0 at the first step
+        factor = min(1.0, self.steps_done / max(1, self.warmup_steps))
+        for group, base_lr in zip(self.optimizer.param_groups, self.base_lrs):
+            group["lr"] = base_lr * factor
+
+    def step(self):
+        self.steps_done += 1
+        if self.steps_done <= self.warmup_steps:
+            self._set_warmup_lr()
+
+    def plateau_step(self, loss: float):
+        if self.steps_done >= self.warmup_steps:
+            self.plateau.step(loss)
+
+    def get_last_lr(self):
+        return [group["lr"] for group in self.optimizer.param_groups]
+
+
