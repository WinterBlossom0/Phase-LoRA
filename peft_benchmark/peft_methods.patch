+from __future__ import annotations
+
+import torch
+
+from peft.tuners.tuners_utils import BaseTuner, BaseTunerLayer
+from peft.utils import TRANSFORMERS_MODELS_TO_PHASE_LORA_TARGET_MODULES_MAPPING
+
+from .layer import PhaseLoraLayer, PhaseLoraLinear
+
+
+class PhaseLoraModel(BaseTuner):
+    prefix: str = "phase_lora_"
+    tuner_layer_cls = PhaseLoraLayer
+    target_module_mapping = TRANSFORMERS_MODELS_TO_PHASE_LORA_TARGET_MODULES_MAPPING
+
+    def _create_and_replace(self, config, adapter_name, target, target_name, parent, current_key, **optional_kwargs):
+        if isinstance(target, PhaseLoraLinear):
+            target.update_layer(
+                adapter_name, config.r, config.lora_alpha, init_weights=config.init_weights,
+                inference_mode=config.inference_mode,
+            )
+            return
+        base = target.get_base_layer() if isinstance(target, BaseTunerLayer) else target
+        if not isinstance(base, torch.nn.Linear):
+            raise TypeError(f"Target module {target} is not supported; only torch.nn.Linear is.")
+        new_module = PhaseLoraLinear(
+            target, adapter_name, config.r, config.lora_alpha, init_weights=config.init_weights,
+            inference_mode=config.inference_mode,
+        )
+        if adapter_name not in self.active_adapters:
+            new_module.requires_grad_(False)
+        self._replace_module(parent, target_name, new_module, target)
