diff --git a/method_comparison/MetaMathQA/run_phase_methods.sh b/method_comparison/MetaMathQA/run_phase_methods.sh
new file mode 100644
index 00000000..de9833e1
--- /dev/null
+++ b/method_comparison/MetaMathQA/run_phase_methods.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+# Local runs of the MetaMathQA benchmark on one 16 GB GPU: LoRA rank 32 (checks this setup against the official
+# result), Phase LoRA and PoLAR. Every run uses the default training parameters plus gradient checkpointing,
+# which keeps batch size 4 within 16 GB. Results go to temporary_results/ because the branch is not main.
+#   bash run_phase_methods.sh                                     # all three, in order
+#   bash run_phase_methods.sh phase_lora/llama-3.2-3B-rank32-gc   # a subset
+# One GPU process at a time: each run takes the shared lock. Stops at the first run that fails or that run.py
+# records as cancelled (run.py exits 0 for a cancelled run, so the script checks cancelled_results/).
+set -euo pipefail
+cd "$(dirname "$0")"
+HERE=$(pwd)
+PY="${PYTHON:-../../.venv/bin/python}"
+LOCK="${PHASE_LORA_GPU_LOCK:-$HOME/.gpu.lock}"
+MIN_FREE_RAM_KB=1572864        # 1.5 GB: the watchdog stops the run below this free RAM
+# run.py saves the trained adapter in a TemporaryDirectory; TMPDIR (set per run below) keeps it here instead of
+# /tmp, which a reboot can clear
+EXPERIMENTS=("$@")
+if [ "${#EXPERIMENTS[@]}" -eq 0 ]; then
+    EXPERIMENTS=(lora/llama-3.2-3B-rank32-gc phase_lora/llama-3.2-3B-rank32-gc polar/llama-3.2-3B-rank32-gc)
+fi
+# run.py writes its result JSON into temporary_results/ but does not create the folder
+mkdir -p logs checkpoints cancelled_results temporary_results
+
+for experiment in "${EXPERIMENTS[@]}"; do
+    stamp=$(date -u +%Y%m%dT%H%M%SZ)
+    log="logs/${experiment//\//--}_$stamp.log"
+    export TMPDIR="$HERE/checkpoints/${experiment//\//--}_$stamp"
+    mkdir -p "$TMPDIR"
+    # the result JSON records only the PEFT commit, and the new methods are uncommitted: keep their exact code
+    { git -C ../.. rev-parse HEAD; git -C ../.. status --short --untracked-files=all
+      find ../../src/peft/tuners/phase_lora ../../src/peft/tuners/polar -name "*.py" -print0 | sort -z | xargs -0 sha256sum
+      git -C ../.. diff; } > "${log%.log}.code.txt"
+    cancelled_before=$(find cancelled_results -type f | wc -l)
+    echo "=== $(date '+%F %T %Z') start $experiment (log $log)"
+    # 3 h limit per run: about twice the expected 1.5 h per run
+    flock "$LOCK" timeout 10800 "$PY" run.py -v "experiments/$experiment" > "$log" 2>&1 &
+    run_pid=$!
+    while kill -0 "$run_pid" 2>/dev/null; do
+        available_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
+        if [ "$available_kb" -lt "$MIN_FREE_RAM_KB" ]; then
+            echo "=== available RAM ${available_kb} kB below 1.5 GB: stopping $experiment" | tee -a "$log"
+            pkill -TERM -P "$run_pid" || true
+            kill -TERM "$run_pid" || true
+        fi
+        sleep 10
+    done
+    status=0
+    wait "$run_pid" || status=$?
+    cancelled_after=$(find cancelled_results -type f | wc -l)
+    if [ "$status" -ne 0 ] || [ "$cancelled_after" -ne "$cancelled_before" ]; then
+        echo "=== $(date '+%F %T %Z') FAILED $experiment (exit $status, see $log)"
+        exit 1
+    fi
+    echo "=== $(date '+%F %T %Z') done $experiment"
+done
